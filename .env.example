# ==================================================
# HR Policy RAG Assistant - Environment Configuration
# ==================================================
# Copy this file to .env and adjust variables as needed for local development.
# Do NOT commit real credentials or production secrets to version control.

# Application Core Settings
APP_NAME="HR Policy RAG Assistant"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8501
LOG_LEVEL="INFO"

# Streamlit Configuration
STREAMLIT_THEME_BASE="light"

# --------------------------------------------------
# Qdrant Vector Database Configuration
# --------------------------------------------------
# For local Qdrant container: http://localhost:6333
# For in-memory (testing/local): :memory:
# For Qdrant Cloud: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="hr_policies"

# --------------------------------------------------
# Embedding Configuration
# --------------------------------------------------
# Provider: "fastembed" (local ONNX, BAAI/bge-small-en-v1.5) or "mock" (for tests)
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384

# --------------------------------------------------
# LLM Generation & Routing Configuration (LiteLLM)
# --------------------------------------------------
# Provider options: "router" (Primary Vertex AI -> Groq fallback), "gemini", "groq", "openai", "mock"
LLM_PROVIDER="router"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Primary: Vertex AI Gemini
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
VERTEX_MODEL="gemini-1.5-pro"

# Fallback: Groq
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional Alternative Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --------------------------------------------------
# Hybrid Search & Jina Reranking Configuration
# --------------------------------------------------
# Jina AI API Key (Leave empty to run in documented degraded fallback mode)
JINA_API_KEY=""
JINA_RERANKER_MODEL="jina-reranker-v2-base-multilingual"

# Hybrid candidate selection & LLM context thresholds
HYBRID_TOP_K=20
RERANK_TOP_K=5
FUSION_STRATEGY="rrf"
RRF_K=60
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4

# --------------------------------------------------
# Google OAuth / OIDC & Authorization Configuration
# --------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8501"

# Authorization Allow-Lists
ALLOWED_EMAIL_DOMAINS="company.com,example.com"
ALLOWED_USERS="employee@company.com,alice@example.com"
ADMIN_USERS="admin@company.com,hr-admin@example.com"

# --------------------------------------------------
# Production Document Storage (Google Cloud Storage)
# --------------------------------------------------
# Bucket format: gs://company-hr-policies/
GCS_BUCKET_NAME="company-hr-policies"
GCS_PROJECT=""
GCS_LOCAL_ROOT="data/storage/gcs_mock"

# --------------------------------------------------
# Observability & LangSmith Tracing
# --------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="hr-policy-rag"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# --------------------------------------------------
# Slack Integration Configuration (Bolt Socket Mode)
# --------------------------------------------------
# Bot User OAuth Token (OAuth & Permissions -> Bot User OAuth Token)
SLACK_BOT_TOKEN="xoxb-your-bot-token"

# App-Level Token for Socket Mode (Basic Information -> App-Level Tokens, scope: connections:write)
SLACK_APP_TOKEN="xapp-your-app-token"

# Slack Authorization Allow-Lists (Comma-separated Slack User IDs, e.g. U12345,U67890)
SLACK_ALLOWED_USERS="U12345,U67890"

# Allowed Employee Email Domains
SLACK_ALLOWED_EMAIL_DOMAINS="xyz.com"

# Slack Admin User IDs (Access to diagnostic metadata)
SLACK_ADMIN_USERS="U12345"

# Per-User Rate Limiting
SLACK_RATE_LIMIT_REQUESTS=10
SLACK_RATE_LIMIT_WINDOW=60




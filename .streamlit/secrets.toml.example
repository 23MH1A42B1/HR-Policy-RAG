# ==============================================================================
# Streamlit Native Google OIDC Configuration
# ==============================================================================
# To enable real Google authentication with st.login(), copy this file to:
# .streamlit/secrets.toml
# and provide your Google OAuth 2.0 Web Client credentials from Google Cloud Console.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "change-this-to-a-secure-random-32-byte-hex-string"
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
